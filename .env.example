# Kopirati ovaj fajl u ".env" i popuniti stvarnim vrednostima.
# .env fajl se NIKADA ne komituje na GitHub (vec je naveden u .gitignore).

# Izbor LLM provajdera: "openai" ili "ollama"
LLM_PROVIDER=openai

# --- Podesavanja za OpenAI (ako je LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Podesavanja za Ollama (ako je LLM_PROVIDER=ollama, lokalni model) ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
